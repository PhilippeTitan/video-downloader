# Base path the UI calls for the downloader API.
# Leave as /api so the dev server proxy forwards to the local service.
VITE_API_BASE=/api

# Where the Vite dev server proxies /api during development.
# Point this at the downloader service (Python/Node) running locally.
VITE_DEV_BACKEND=http://127.0.0.1:8000

# Set to true to skip probing the backend and always use sample data.
VITE_DEMO=false
