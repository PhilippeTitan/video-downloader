{
  "name": "expo-app",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/cli": "^57.0.28",
    "@expo/ngrok-bin": "^2.3.42",
    "expo": "~57.0.28",
    "expo-asset": "~57.0.19",
    "expo-constants": "~57.0.21",
    "expo-status-bar": "~57.0.1",
    "got": "^11.8.6",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "bundle:web": "node ../tools/inline.cjs && node ../tools/expo-bundle.cjs",
    "prestart": "npm run bundle:web",
    "prestart:tunnel": "npm run bundle:web",
    "start": "node ../tools/expo-start.cjs",
    "start:tunnel": "node ../tools/expo-start.cjs --tunnel --port 8081",
    "start:plain": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web"
  },
  "private": true
}
